def encrypt_sentence(msg):
    v=''
    nl=[]
    nm=[]
    l=msg.split()
    #print(l)
    for i,item in enumerate(l,start=1):
        #print(f"Index: {i}, Item: {item}")
        if(i%2==0):
            for j in item:
                if(j=='a' or j=='e' or j=='i' or j=='o' or j=='u'):
                    s=item.replace(j,"");
                    v=s+j
                    nl.append(v)
        else:
            r=item[::-1]
            nl.append(r)
    return (nl)
